{
  "name": "ludoteca",
  "version": "1.0.0",
  "description": "Jogos na TV, com o celular de controle. Rode com: npx github:AdanEinstein/ludoteca",
  "bin": { "ludoteca": "bin/ludoteca.js" },
  "files": ["bin", "server", "games", "public", "brand/final"],
  "scripts": {
    "test": "node --test \"server/**/*.test.ts\" \"games/**/*.test.ts\" \"public/**/*.test.ts\"",
    "start": "node server/index.ts",
    "dev": "LUDOTECA_DEV=1 node --watch --watch-preserve-output server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.browser.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": { "node": "^26.13.1" },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "htm": "3.1.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "preact": "10.29.8",
    "typescript": "7.0.2"
  },
  "type": "module"
}
